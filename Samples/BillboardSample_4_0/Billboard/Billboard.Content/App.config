<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<appSettings>
		<add key="XnaPlatform" value="Windows" />
		<add key="XnaProfile" value="HiDef" />
		<add key="Configuration" value="Release" />
		<!--extensions-->
		<!--<add key="extension.test" value="TestImporter;TestProcessor" />-->
		<!-- Textures -->
		<add key="extension.png" value="TextureImporter;TextureProcessor" />
		<add key="extension.jpg" value="TextureImporter;TextureProcessor" />
		<add key="extension.jpeg" value="TextureImporter;TextureProcessor" />
		<add key="extension.bmp" value="TextureImporter;TextureProcessor" />
		<add key="extension.tga" value="TextureImporter;TextureProcessor" />
		<add key="extension.dds" value="TextureImporter;TextureProcessor" />

		<!-- Effects -->
		<add key="extension.fx" value="EffectImporter;EffectProcessor" />

		<!-- Models -->
		<add key="extension.fbx" value="FbxImporter;ModelProcessor" />
		<add key="extension.x" value="XImporter;ModelProcessor" />

		<!-- Fonts -->
		<add key="extension.spritefont" value="FontDescriptionImporter;FontDescriptionProcessor" />

		<!-- Video -->
		<add key="extension.wmv" value="WmvImporter;VideoProcessor" />

		<!-- XML / Data -->
		<add key="extension.xml" value="XmlImporter;XmlProcessor" />

	</appSettings>
</configuration>
